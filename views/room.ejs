<%- include('layout', { title: room.title }) %>
<section>
  <h2><%= room.title %></h2>
  <% if (room.image) { %>
    <img src="<%= room.image %>" alt="<%= room.title %>" />
  <% } %>
  <p><%= room.description %></p>
  <p>Type: <%= room.type %></p>
  <p>Price per night: $<%= room.price %></p>

  <h3>Book this room</h3>
  <form action="/book" method="post">
    <input type="hidden" name="room_id" value="<%= room.id %>" />
    <label>Name: <input name="name" required></label><br/>
    <label>Email: <input name="email" type="email" required></label><br/>
    <label>Phone: <input name="phone"></label><br/>
    <label>Check-in: <input name="checkin" type="date"></label><br/>
    <label>Check-out: <input name="checkout" type="date"></label><br/>
    <label>Nights: <input name="nights" type="number" min="1" value="1"></label><br/>
    <input type="hidden" name="total" value="<%= room.price %>">
    <button type="submit">Proceed to Payment</button>
  </form>
</section>
