<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%= siteName %> - <%= title || '' %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header>
      <h1><a href="/"> <%= siteName %> </a></h1>
      <nav>
        <a href="/rooms">Rooms</a>
        <% if (!currentUser) { %>
          <a href="/admin/login">Admin</a>
        <% } else { %>
          <a href="/admin">Dashboard</a>
        <% } %>
      </nav>
    </header>
    <main>
      <%- body %>
    </main>
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> <%= siteName %></p>
    </footer>
  </body>
</html>
