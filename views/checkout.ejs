<%- include('layout', { title: 'Checkout' }) %>
<section>
  <h2>Checkout</h2>
  <p>Booking reference: <%= booking.id %></p>
  <p>Room: <%= booking.room_title %></p>
  <p>Name: <%= booking.name %></p>
  <p>Total: $<%= booking.total %></p>

  <h3>Pay with</h3>
  <form id="google-pay-form" method="post" action="/payments/googlepay/success">
    <input type="hidden" name="booking_id" value="<%= booking.id %>">
    <button type="submit">Simulate Google Pay (demo)</button>
  </form>

  <p>Bank gateways (BML/MIB/SIB) are placeholders. Admin can add merchant credentials and enable integrations in the future.</p>
</section>
