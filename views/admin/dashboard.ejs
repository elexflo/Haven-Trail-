<%- include('../layout', { title: 'Admin Dashboard' }) %>
<section>
  <h2>Bookings</h2>
  <p><a href="/admin/rooms">Manage Rooms</a></p>
  <table>
    <thead><tr><th>ID</th><th>Name</th><th>Room</th><th>Total</th><th>Paid</th><th>When</th></tr></thead>
    <tbody>
      <% bookings.forEach(function(b){ %>
        <tr>
          <td><%= b.id %></td>
          <td><%= b.name %></td>
          <td><%= b.room_id %></td>
          <td><%= b.total %></td>
          <td><%= b.paid ? 'Yes' : 'No' %></td>
          <td><%= b.created_at %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
