<%- include('../layout', { title: 'Rooms Management' }) %>
<section>
  <h2>Rooms</h2>
  <p><a href="/admin/rooms/new">Add new room</a></p>
  <table>
    <thead><tr><th>ID</th><th>Title</th><th>Type</th><th>Price</th><th>Image</th><th>Actions</th></tr></thead>
    <tbody>
      <% rooms.forEach(function(r){ %>
        <tr>
          <td><%= r.id %></td>
          <td><%= r.title %></td>
          <td><%= r.type %></td>
          <td><%= r.price %></td>
          <td><% if (r.image) { %><img src="<%= r.image %>" style="height:40px" /><% } %></td>
          <td><a href="/admin/rooms/<%= r.id %>/edit">Edit</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
