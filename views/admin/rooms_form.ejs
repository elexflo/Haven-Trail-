<%- include('../layout', { title: room && room.id ? 'Edit Room' : 'New Room' }) %>
<section>
  <h2><%= room && room.id ? 'Edit Room' : 'New Room' %></h2>
  <form method="post" action="<%= room && room.id ? '/admin/rooms/' + room.id : '/admin/rooms' %>" enctype="multipart/form-data">
    <label>Title <input name="title" value="<%= room.title || '' %>"></label><br/>
    <label>Type <input name="type" value="<%= room.type || '' %>"></label><br/>
    <label>Price <input name="price" type="number" step="0.01" value="<%= room.price || '' %>"></label><br/>
    <label>Description<br/><textarea name="description"><%= room.description || '' %></textarea></label><br/>
    <label>Image <input type="file" name="image"></label><br/>
    <button type="submit">Save</button>
  </form>
</section>
