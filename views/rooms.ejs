<%- include('layout', { title: 'Rooms' }) %>
<section>
  <h2>Rooms</h2>
  <div class="rooms">
    <% rooms.forEach(function(room){ %>
      <div class="room">
        <% if (room.image) { %>
          <img src="<%= room.image %>" alt="<%= room.title %>" />
        <% } %>
        <h3><a href="/rooms/<%= room.id %>"><%= room.title %></a></h3>
        <p><%= room.type %> - $<%= room.price %></p>
      </div>
    <% }) %>
  </div>
</section>
